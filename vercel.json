{
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        { "key": "Content-Type", "value": "application/json" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/claim", "destination": "/claim/index.html" },
    { "source": "/welcome-mail/(.*)", "destination": "/welcome-mail/index.html" },
    { "source": "/r/(.*)", "destination": "/welcome-mail/index.html" },
    { "source": "/u/(.*)", "destination": "/u/index.html" },
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms", "destination": "/terms.html" },
    { "source": "/compose/(.*)", "destination": "/compose/index.html" }
  ]
}
